


# Docker Swarm




networks:
  public-net:
    driver: overlay
  internal-net:
    driver: overlay
    #internal: true

services:

  # ---------------------------------------------------------------------------
  # TRAEFIK REVERSE PROXY (Exposed to host port 1234)
  # ---------------------------------------------------------------------------
  traefik:
    image: traefik:v3.0
    container_name: traefik
    hostname: traefik
    ports:
      - "1234:80"     # Single public endpoint for clients
      - "1233:8080"   # Traefik Dashboard UI
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro




    command:
      - "--api.dashboard=true"
      - "--api.insecure=true"
      - "--providers.swarm=true"
      - "--providers.swarm.network=nextcloud-stack-internal-net"


      - "--providers.swarm.exposedByDefault=false"
      - "--providers.docker.exposedByDefault=false"


      - "--providers.file.directory=/1234"
      - "--providers.file.watch=true"


      - "--entrypoints.web.address=:80"
      - "--log.level=INFO"
      - "--accesslog=true"

      - "--metrics.prometheus=true"
      - "--metrics.prometheus.entryPoint=traefik"



    entrypoint:
      - /bin/sh
      - -c
      - |
        mkdir -p /1234

        cat > /1234/dynamic.yml <<'EOF'
        http:
          routers:
            firefox-blue:
              rule: "PathPrefix(`/`) && HeaderRegexp(`User-Agent`, `Firefox`)"
              priority: 100
              entryPoints:
                - web
              service: firefox-service-blue@file

            edge-green:
              rule: "PathPrefix(`/`) && HeaderRegexp(`User-Agent`, `Edg/`)"
              priority: 100
              entryPoints:
                - web
              service: edge-service-green@file

            default:
              rule: "PathPrefix(`/`)"
              priority: 1
              entryPoints:
                - web
              service: nextcloud-weighted@file

          services:
            firefox-service-blue:
              weighted:
                services:
                  - name: bluefirefox@swarm
                    weight: 100

            edge-service-green:
              weighted:
                services:
                  - name: greenedge@swarm
                    weight: 100

            nextcloud-weighted:
              weighted:
                services:
                  - name: bluefirefox@swarm
                    weight: 50
                  - name: greenedge@swarm
                    weight: 50
        EOF

        exec traefik "$$@"


    networks:
      - public-net
      - internal-net


    deploy:
      replicas: 1
      placement:
        constraints: [node.role == manager]
      labels:
        - "traefik.enable=false"

  # ---------------------------------------------------------------------------
  # NEXTCLOUD BLUE (v25.0.4)
  # ---------------------------------------------------------------------------


  nextcloudbluefirefox:
    image: nextcloud:25.0.4-apache

    container_name: nextcloudbluefirefox
    hostname: nextcloudbluefirefox

    environment:
      - SQLITE_DATABASE=sqlitedatabasexample
      - NEXTCLOUD_ADMIN_USER_FILE=/1234/ncadminuser
      - NEXTCLOUD_ADMIN_PASSWORD_FILE=/1234/ncadminpassword
      - NEXTCLOUD_TRUSTED_DOMAINS_FILE=/1234/nctrusteddomains

    tmpfs:
      - /var/www:rw,exec,nosuid,size=1g
      - /1234/:ro,exec,nosuid,size=1m
    volumes:
      - ../../ncadminuser.txt:/1234/ncadminuser:ro
      - ../../ncadminpassword.txt:/1234/ncadminpassword:ro
      - ../../nctrusteddomains.txt:/1234/nctrusteddomains:ro
     
    entrypoint: ["/bin/bash", "-c", "
      /entrypoint.sh apache2-foreground &
      sleep 5m && su -s /bin/sh www-data -c 'php occ app:install spreed' || true &&
      su -s /bin/sh www-data -c 'php occ app:disable survey_client' || true &&
      echo '<h1>BLUE INSTANCE </h1>' > /var/www/html/instance-id.html &&
      wait "]

    networks:
      - internal-net

    deploy:
      replicas: 1
      labels:
        - "traefik.enable=true"
        - "traefik.http.services.bluefirefox.loadbalancer.server.port=80"
        - "traefik.http.routers.bluefirefox.entrypoints=web"
        - "traefik.http.routers.bluefirefox.rule=PathPrefix(`/`)"




  # ---------------------------------------------------------------------------
  # NEXTCLOUD GREEN (v25.0.5)
  # ---------------------------------------------------------------------------


  nextcloudgreenedge:
    image: nextcloud:25.0.5-apache

    container_name: nextcloudgreenedge
    hostname: nextcloudgreenedge

    environment:
      - SQLITE_DATABASE=sqlitedatabasexample
      - NEXTCLOUD_ADMIN_USER_FILE=/1234/ncadminuser
      - NEXTCLOUD_ADMIN_PASSWORD_FILE=/1234/ncadminpassword
      - NEXTCLOUD_TRUSTED_DOMAINS_FILE=/1234/nctrusteddomains

    tmpfs:
      - /var/www:rw,exec,nosuid,size=1g
      - /1234/:ro,exec,nosuid,size=1m
    volumes:
      - ../../ncadminuser.txt:/1234/ncadminuser:ro
      - ../../ncadminpassword.txt:/1234/ncadminpassword:ro
      - ../../nctrusteddomains.txt:/1234/nctrusteddomains:ro
     
    entrypoint: ["/bin/bash", "-c", "
      /entrypoint.sh apache2-foreground &
      sleep 5m && su -s /bin/sh www-data -c 'php occ app:install spreed' || true &&
      su -s /bin/sh www-data -c 'php occ app:disable survey_client' || true &&
      echo '<h1>GREEN INSTANCE </h1>' > /var/www/html/instance-id.html &&
      wait "]


    networks:
      - internal-net


    deploy:
      # Start Green 0  Scale to 1 when ready 

      replicas: 1
      labels:
        - "traefik.enable=true"
        - "traefik.http.services.greenedge.loadbalancer.server.port=80"
        - "traefik.http.routers.greenedge.entrypoints=web"
        - "traefik.http.routers.greenedge.rule=PathPrefix(`/`)"


  nextcloud-exporter-greenedge:
    image: xperimental/nextcloud-exporter:0.9.1
    container_name: nextcloud-exporter-greenedge
    hostname: nextcloud-exporter-greenedge
    ports:
      - "9203:9205"
    environment:
      - NEXTCLOUD_SERVER=http://nextcloudgreenedge:80
      - NEXTCLOUD_USERNAME=1
      - NEXTCLOUD_PASSWORD=1
    networks:
      - internal-net
    deploy:
      replicas: 1


  nextcloud-exporter-bluefirefox:
    image: xperimental/nextcloud-exporter:0.9.1
    container_name: nextcloud-exporter-bluefirefox
    hostname: nextcloud-exporter-bluefirefox
    ports:
      - "9205:9205"
    environment:
      - NEXTCLOUD_SERVER=http://nextcloudbluefirefox:80
      - NEXTCLOUD_USERNAME=1
      - NEXTCLOUD_PASSWORD=1
    networks:
      - internal-net
    deploy:
      replicas: 1

